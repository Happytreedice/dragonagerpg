{{!-- Диалог параметров теста AGE --}}
<div class="darpg test-dialog">
    {{#if abilityLabel}}
    <p class="test-ability">{{localize "DARPG.Roll.Ability"}}: <strong>{{abilityLabel}}</strong></p>
    {{/if}}
    <div class="form-group">
        <label>{{localize "DARPG.Roll.Focus"}}</label>
        <div class="form-fields">
            <select name="focus">
                <option value="">{{localize "DARPG.Roll.NoFocus"}}</option>
                {{#each focuses}}
                <option value="{{this.name}}" {{#if this.selected}}selected{{/if}}>{{this.name}}</option>
                {{/each}}
            </select>
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "DARPG.Roll.Modifier"}}</label>
        <div class="form-fields">
            <input type="number" name="modifier" value="0" step="1">
        </div>
    </div>
    <div class="form-group">
        <label>{{localize "DARPG.Roll.TargetNumber"}}</label>
        <div class="form-fields">
            <input type="number" name="targetNumber" value="{{targetNumber}}" min="0" step="1"
                   placeholder="{{localize 'DARPG.Roll.TargetNumberHint'}}">
        </div>
    </div>
</div>
